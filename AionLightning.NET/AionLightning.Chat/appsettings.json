{
  "ChatServer": {
    "Network": {
      "BindAddress": "0.0.0.0",
      "ClientPort": 10241,
      "GameServerPort": 9021
    },
    "Auth": {
      "Password": "*",
      "MessageDelaySeconds": 30
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "log/chatserver-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  }
}
